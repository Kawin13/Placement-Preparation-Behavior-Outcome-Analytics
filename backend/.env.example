# ==============================================================================
# PLACEMENT PREPARATION PLATFORM - BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# Instructions: Copy this file to '.env' and fill in your local environment values.
# NEVER commit the actual '.env' file containing secrets to source control.
# ==============================================================================

# Application Metadata
PROJECT_NAME="Placement Preparation Behavior & Outcome Analytics"
API_V1_STR=/api/v1
ENVIRONMENT=development

# Security: Generate a secure 64-character secret using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_secure_random_hex_key_for_jwt_signing

# JWT Token Expiry in Minutes (1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Native Connection String
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://postgres:your_local_postgres_password@localhost:5432/placement_portal

# Allowed Frontend Origins for CORS (JSON array or comma-separated URLs)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
